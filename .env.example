# ---------------------------------------------------------------------------
# Zoho ZeptoMail (https://www.zoho.com/zeptomail/)
# Mail Agents -> your agent -> SMTP/API -> "Send Mail token".
# Use api.zeptomail.in for the India DC, api.zeptomail.com for US, etc.
# ---------------------------------------------------------------------------
ZEPTO_URL=api.zeptomail.in/
ZEPTO_TOKEN="Zoho-enczapikey AAA=="
ZEPTO_FROM_EMAIL=noreply@thelaxm.com
ZEPTO_FROM_NAME=LaxmMonitor

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Comma-separated default recipients (an endpoint can override with "notify").
ALERT_RECIPIENTS=admin@example.com
# Consecutive failed checks before a DOWN email is sent (1 = alert on first failure).
# One email per outage: DOWN once, then UP once when it recovers.
ALERT_THRESHOLD=1
# Timezone used for timestamps in emails (IANA name).
DISPLAY_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
MAX_WORKERS=10
ENDPOINTS_FILE=config/endpoints.json
# Remembers which alerts were already sent (prevents duplicates across restarts).
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Anvil deployment (only for deploy/anvil/sync_endpoints.py)
# Anvil IDE -> Uplink -> Enable server Uplink -> copy the key.
# ---------------------------------------------------------------------------
ANVIL_UPLINK_KEY=
